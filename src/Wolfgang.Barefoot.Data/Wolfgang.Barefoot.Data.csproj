<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Barefoot is an application: its assemblies ship inside the hosts, never as NuGet packages. -->
    <IsPackable>false</IsPackable>
    <Description>Barefoot's data access: the EF Core model of the Core entities and the conventions every table follows.</Description>
  </PropertyGroup>

  <!-- Data maps the Core entities and nothing else (DESIGN §2). -->
  <ItemGroup>
    <ProjectReference Include="..\Wolfgang.Barefoot.Core\Wolfgang.Barefoot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Production runs on SQL Server (ADR 0001). Only Migrations/ and the design-time factory use the provider:
         the model itself names none, so the tests run it on SQLite. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <!-- What `dotnet ef migrations` needs at design time. It is not distributed with the hosts. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wolfgang.Barefoot.Data.Tests.Unit" />
  </ItemGroup>

</Project>

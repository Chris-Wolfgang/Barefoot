<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Barefoot is an application: its assemblies ship inside the hosts, never as NuGet packages. -->
    <IsPackable>false</IsPackable>
    <Description>Barefoot's API contract: the request and response records the Core interfaces take and return, and the contract revision. References no project and no framework.</Description>
  </PropertyGroup>

</Project>

# Rules that apply to every project under src/, on top of the repository's root .editorconfig.

[*.cs]

# CA2007: every await states its continuation context, in every src/ project and in every
# configuration - no host is exempt. `ConfigureAwait(false)` everywhere except a Blazor
# component, which says `ConfigureAwait(true)` because it must resume on the renderer's
# context. The root file sets `warning`, which fails only a Release build; `error` fails a
# Debug build too, so the rule is met before the code reaches CI.
dotnet_diagnostic.CA2007.severity = error

# RS0030: a banned symbol (BannedSymbols.txt - blocking waits, synchronous file I/O, the
# static clocks) is an error in every configuration. Stated here so the rule does not depend
# on the root file keeping it.
dotnet_diagnostic.RS0030.severity = error

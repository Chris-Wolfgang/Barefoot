<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Barefoot is an application: its assemblies ship inside the hosts, never as NuGet packages. -->
    <IsPackable>false</IsPackable>
    <Description>Barefoot's business rules: the run lifecycle, search editing, catalog diffing, digests, vocabulary and settings (ADR 0002).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wolfgang.Barefoot.Core\Wolfgang.Barefoot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wolfgang.Barefoot.Business.Tests.Unit" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- A library of test doubles, not a test project: it has no tests of its own to run.
         Its tests are in Wolfgang.Barefoot.TestKit.Tests.Unit. -->
    <IsTestProject>false</IsTestProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- The kit holds doubles of Core interfaces, so it references Core and nothing above it. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Wolfgang.Barefoot.Core\Wolfgang.Barefoot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
  </ItemGroup>

</Project>
